# ==========================================================================
# ThermalWatch backend â€” production environment template.
# Copy to .env on the backend host and fill in real values.
# NEVER commit real secrets; .env is gitignored.
# ==========================================================================

# NASA FIRMS API map key (used by the ingestion/pipeline scripts).
# Get one free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=YOUR_KEY_HERE

# Optional: override default study-area bounding box (India, WGS84 degrees).
STUDY_AREA_WEST=68
STUDY_AREA_SOUTH=6
STUDY_AREA_EAST=97
STUDY_AREA_NORTH=36

# CORS: comma-separated list of origins allowed to call this API directly.
# Production: set this to your Vercel frontend origin, e.g.
#   CORS_ORIGINS=https://thermalwatch.vercel.app
# When unset the API allows only localhost origins (dev default). If the
# frontend talks to the API through a same-origin reverse proxy / rewrite,
# CORS is not involved and this can stay unset.
CORS_ORIGINS=

# Prototype SMS notification (backend only; never expose these to Vite/React).
# ThermalWatch sends decision-support prototype messages only after operator confirmation.
PROTOTYPE_SMS_TO=YOUR_PROTOTYPE_RECIPIENT_E164
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=YOUR_TWILIO_FROM_NUMBER_E164

# Twilio TRIAL predefined template. Official trial behavior (Twilio docs
# "Try out Twilio SMS Messaging"): trial accounts CANNOT send free-form SMS
# bodies - the Messages API `Body` must be exactly one of Twilio's predefined
# template ids (otherwise Twilio error 572006). The Content API / ContentSid is
# NOT available on trial accounts (error 20003 "not available on a Trial account").
#
# The Console's Try Out SMS screen labels this "Event Notifications"; set either
# the label or the template id below:
TWILIO_TEMPLATE_NAME=sms_event_notifications
# Accepted ids: sms_2fa, sms_appointment_reminders, sms_order_confirmation,
# sms_delivery_updates, sms_customer_support, sms_marketing_promotions,
# sms_event_notifications, sms_account_alerts, sms_feedback_surveys, sms_internal_alerts
#
# NOTE: on a trial account the recipient receives Twilio's predefined text for
# the chosen template (you cannot send custom alert wording during trial).
#
# After upgrading, free-form content is allowed: leave TWILIO_TEMPLATE_NAME empty
# to send the rich prototype message text, or set TWILIO_CONTENT_SID to an HX...
# SID of a registered Content API template (with optional TWILIO_CONTENT_VARIABLES
# JSON; ContentVariables map 1..10 to severity, cluster_id, risk_score, lat,lon,
# classification, evidence, observation_count, active_days, station_name, distance_km).
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CONTENT_VARIABLES={"1": "CRITICAL", "2": "1105"} # optional; defaults supplied by the backend

