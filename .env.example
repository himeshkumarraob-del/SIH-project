# NASA FIRMS API map key.
# Get one for free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NEVER commit your real key. Copy this file to .env and fill it in there.
FIRMS_MAP_KEY=YOUR_KEY_HERE

# Optional: override default study-area bounding box (India, WGS84 degrees)
STUDY_AREA_WEST=68
STUDY_AREA_SOUTH=6
STUDY_AREA_EAST=97
STUDY_AREA_NORTH=36
